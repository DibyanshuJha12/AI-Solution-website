APP_ENV=development
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret
# Leave the PostgreSQL values blank if you want the app to use the built-in
# SQLite fallback for local development.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Optional alternative if you prefer a single SQLAlchemy URL:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/your_database_name
DATABASE_FALLBACK_TO_SQLITE=true

# Local development:
# Keep this true only while testing locally without real Google reCAPTCHA keys.
ALLOW_INSECURE_DEV_CAPTCHA=true

# The site uses a custom numerical CAPTCHA for protected forms and can also
# verify Google reCAPTCHA server-side when production keys are configured.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.4

# AI credentials must stay server-side. Never place this in static JavaScript.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
CHATBOT_REQUEST_TIMEOUT_SECONDS=18
CHATBOT_RATE_LIMIT_COUNT=12
CHATBOT_RATE_LIMIT_WINDOW_SECONDS=60
CHATBOT_DUPLICATE_WINDOW_SECONDS=4
CHATBOT_GEMINI_RETRY_COUNT=2

ADMIN_ROUTE_PREFIX=/secure-admin
ADMIN_EMAIL=admin@aisolutionsglobal.co.uk
ADMIN_PASSWORD=Admin@123
EMAIL_SERVICE_MODE=placeholder
EMAIL_FROM_NAME=AI SOLUTION
EMAIL_FROM_ADDRESS=admin@aisolutionsglobal.co.uk
EMAIL_REPLY_TO_ADDRESS=admin@aisolutionsglobal.co.uk
EMAIL_NOTIFICATION_TO=admin@aisolutionsglobal.co.uk
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=your-gmail-address@gmail.com
EMAIL_SMTP_PASSWORD=your-gmail-app-password
EMAIL_SMTP_USE_TLS=true
EMAIL_SMTP_USE_SSL=false
EMAIL_SMTP_TIMEOUT_SECONDS=20
INQUIRY_DUPLICATE_WINDOW_SECONDS=600
FEEDBACK_DUPLICATE_WINDOW_SECONDS=600

# Keep false for local HTTP preview. Set true behind HTTPS in production.
SESSION_COOKIE_SECURE=false
EXPOSE_RESET_LINKS_IN_DEBUG=true
